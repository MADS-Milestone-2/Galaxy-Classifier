    "# Adapting a CNN for 5 channels\n",
    "\n",
    "Standard pre-trained CNNs expect 3 channels (RGB). GalaxyML data has 5 channels (u, g, r, i, z). We will modify a standard `ResNet18` to accept 5 channels"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f7b69f65",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_galaxy_model():\n",
    "    # Start with an untrained ResNet-18 model\n",
    "    model = models.resnet18(weights=None)  \n",
    "    \n",
    "    # Modify the first convolutional layer to accept 5 input channels instead of 3\n",
    "    model.conv1 = nn.Conv2d(\n",
    "        in_channels=5, \n",
    "        out_channels=64, \n",
    "        kernel_size=7, \n",
    "        stride=2, \n",
    "        padding=3, \n",
    "        bias=False\n",
    "    )\n",
    "    \n",
    "    # Modify the final fully connected layer to output the number of classes (e.g., 10)\n",
    "    num_classes = 3  # Update this based on your specific classification task\n",
    "    model.fc = nn.Linear(\n",
    "        in_features=model.fc.in_features, \n",
    "        out_features=num_classes\n",
    "    )\n",
    "    \n",
    "    return model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7efe20fc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Output shape: torch.Size([2, 3])\n"
     ]
    }
   ],
   "source": [
    "model = get_galaxy_model()\n",
    "sample_input = torch.randn(2, 5, 127, 127)  # Batch size of 2, 5 channels, 127x127 image\n",
    "output = model(sample_input)\n",
    "print(\"Output shape:\", output.shape)  # Should be (2, num_classes)"
   ]
  },
